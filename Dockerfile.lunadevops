# Luna DevOps 专用后端构建 Dockerfile：默认使用 reg.liteyuki.org 预制品基础镜像以跳过工具链安装与 FFmpeg 编译
# 原生全量构建（GitHub Actions / 开源通用）请继续使用根目录 Dockerfile
ARG GO_BUILDER_IMAGE=reg.liteyuki.org/snowykami/neo-blog-go-builder:1.26.10-alpine3.24
ARG RUNTIME_IMAGE=reg.liteyuki.org/snowykami/neo-blog-runtime:alpine3.24-ffmpeg7.1.1

FROM ${GO_BUILDER_IMAGE} AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY . .

RUN go build -o server ./cmd/server

# production（已预置 tzdata、neo-blog 用户与裁剪版纯音频 LGPLv2.1 ffmpeg）
FROM ${RUNTIME_IMAGE} AS prod

WORKDIR /app

COPY --from=builder --chown=neo-blog:neo-blog /app/server /app/server

RUN chmod +x /app/server

USER neo-blog

EXPOSE 8888

HEALTHCHECK --interval=30s --timeout=3s --start-period=30s --retries=3 \
  CMD ["/app/server", "-healthcheck"]

ENTRYPOINT ["/app/server"]
