# 后端所有环境变量及其示例

# Captcha settings 机器人挑战配置
# 开发模式下的直接通过验证码
CAPTCHA_DEV_PASSCODE=114514
# captcha类型，支持turnstile recaptcha hcaptcha，disable为禁用验证码
CAPTCHA_TYPE=turnstile
# captcha设置
CAPTCHA_SITE_SECRET=89dh29djha28dh
CAPTCHA_SECRET_KEY=89dh28912dh1289dh128d9d

# Database settings 数据库配置
# 数据库连接地址（可选）：设置后以它为准，下面的 DB_* 全部忽略；驱动由 scheme 决定，不认识的 scheme 会拒绝启动
# Postgres：postgres://user:password@host:5432/dbname?sslmode=disable（也可用 postgresql://，密码中的特殊字符需 URL 编码）
# SQLite：sqlite:///abs/path/blog.db（绝对路径）、sqlite://./data/data.db 或 file:./data/data.db（相对路径）
# DB_URL=postgres://blog:blog@postgres:5432/blog?sslmode=disable
# 未设置 DB_URL 时使用以下配置
# 数据库驱动，支持sqlite postgres
DB_DRIVER=sqlite
DB_NAME=blog
DB_PATH=./data/data.db
DB_HOST=postgres
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog
# postgres数据库SSL模式
DB_SSLMODE=disable

# Redis 共享状态（可选）：未设置时使用进程内存，只支持单实例部署；
# 后端多副本部署时必须设置，并使用 Postgres 与 S3 / WebDAV（或共享卷）存储
# 格式：redis://[user:password@]host:6379/0，TLS 用 rediss://，也支持 unix:///path/to/redis.sock；配置了但连不上时拒绝启动
# REDIS_URL=redis://:password@redis:6379/0
# REDIS_KEY_PREFIX=neo-blog:

# Email settings 邮件配置
EMAIL_ENABLED=false
EMAIL_USERNAME=xxx@bbb.com
EMAIL_PASSWORD=xxx
EMAIL_ADDRESS=xxx@bbb.com
EMAIL_HOST=smtp.xxx.com
EMAIL_PORT=465
EMAIL_SSL=true

# App settings 应用程序配置
LOG_LEVEL=info
BASE_URL=https://blog.shenyu.moe
MAX_REQUEST_BODY_SIZE=1000000
MODE=prod
PORT=8888
PASSWORD_SALT=replace_with_at_least_16_random_chars
JWT_SECRET=replace_with_at_least_32_random_chars
TOKEN_DURATION=3600
REFRESH_TOKEN_DURATION=604800
# 文件缓存配置 File cache settings
MAX_CACHE_FILE=100

# 自定义 TTML 歌词源（可选，也可在后台「全局配置 › 音乐播放器」中设置，这里设置时优先）：含 {id} 或 {song_id} 时为地址模板（替换为网易云歌曲 id），否则为目录前缀，拼接 {前缀}/{id}.ttml
# 单个地址视为一个没有名称的源；多个源写成 JSON 数组，按顺序查找，名称显示在播放器的歌词来源标签上
# MUSIC_TTML_URL_PREFIX=https://cdn.example.com/music/lyrics/{id}.ttml
# MUSIC_TTML_URL_PREFIX=[{"name":"liteyuki源","url":"https://cdn.liteyuki.org/music/lyrics/{id}.ttml"},{"name":"备用源","url":"https://static.example.com/ttml"}]

# RSS 输出的文章数、站点地图每类条目的上限（可选，也可在后台「全局配置」中设置，这里设置时优先）
# RSS_LIMIT=30
# SITEMAP_LIMIT=5000

# AI 用户：每个实例同时执行的任务数（worker 数），默认 2，设为 0 时本实例不执行任务
# AI_AGENT_WORKERS=2
